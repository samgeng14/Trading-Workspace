# IBKR connection — read by trading-engine/src/broker/ibkr/settings.py.
# Leave unset to use trading-engine/config/broker.yaml.
# IB Gateway: paper 4002 / live 4001.  TWS: paper 7497 / live 7496.
IBKR_HOST=127.0.0.1
IBKR_PORT_PAPER=4002
IBKR_PORT_LIVE=4001
# Optional: pin the account (paper IDs start with "D").
IBKR_ACCOUNT_PAPER=
IBKR_ACCOUNT_LIVE=
# Optional: move the fixed clientId block if it collides with other tools.
IBKR_CLIENT_ID_BASE_PAPER=300
IBKR_CLIENT_ID_BASE_LIVE=400

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

TEAMS_WEBHOOK_URL=
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
