# Before each daily run: the IBKR doctor (trading-engine/src/broker/ibkr/doctor.py),
# end to end from the socket to a whatIf order preview; nothing is sent. Its
# report is the dashboard's latest, and the day's copy (artifacts/doctor) is what
# Phase 0's exit test reads (bin/tradeit exit-test). A FAIL fails the unit, so
# the alert comes before the run. Started by dv02-doctor.timer.
[Unit]
Description=DV02 IBKR doctor before the daily run
Wants=network-online.target
After=network-online.target docker.service
OnFailure=dv02-alert@%n.service

[Service]
Type=oneshot
User=dv02
Group=dv02
WorkingDirectory=/opt/dv02/trading-engine
EnvironmentFile=/etc/dv02/dv02.env
Environment=APP_ENV=vm
ExecStart=/opt/dv02/.venv/bin/python -m src.broker.ibkr.doctor --save
ExecStartPost=/opt/dv02/deploy/bin/heartbeat doctor
TimeoutStartSec=5min
NoNewPrivileges=true
PrivateTmp=true
