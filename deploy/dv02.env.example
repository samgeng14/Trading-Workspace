# /etc/dv02/dv02.env on the VM (root:dv02, mode 640). The owner fills it in
# over SSH; it never goes in git or chat. The IBKR login stays in
# /opt/dv02/ibgw/.env (bin/tradeit login) and the Flex token in /opt/dv02/.env
# (bin/tradeit flex), as on the Mac.

# The name the dashboard is reached by: the API refuses any Host it doesn't know.
# deploy/bin/bootstrap sets both to this machine's Tailscale name.
DV02_ALLOWED_HOSTS=dv02.example.com
DV02_ALLOWED_ORIGINS=https://dv02.example.com

# healthchecks.io (or similar) ping URLs, one check per job; uncomment once made
#DV02_HEARTBEAT_RUNNER=https://hc-ping.com/<uuid-for-the-daily-run>
#DV02_HEARTBEAT_BACKUP=https://hc-ping.com/<uuid-for-the-backup>
#DV02_HEARTBEAT_API=https://hc-ping.com/<uuid-for-the-api>

# rclone remote and bucket for backups (rclone config: an S3 remote, provider Cloudflare)
#DV02_BACKUP_REMOTE=r2:dv02-backups

# Postgres (deploy/postgres); the same password goes in /etc/dv02/pg_password
DV02_DB_USER=dv02
DV02_DB_PASSWORD=
