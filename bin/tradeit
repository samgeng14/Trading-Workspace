#!/usr/bin/env bash
# tradeit: run the DV02 Fund stack on this machine.
#
#   tradeit setup     one-time: Python env (.venv), dashboard packages, .env
#   tradeit login     save the IB Gateway login on this Mac (for automatic login)
#   tradeit gateway   start | stop | status | logs  the auto-login IB Gateway (Docker)
#   tradeit flex      connect IBKR Flex: daily NAV since the account opened
#   tradeit refresh   fill price-history holes, update bars and targets (dry run: no orders)
#   tradeit doctor    check the IBKR connection end to end
#   tradeit up        gateway (if saved) + API (:8000) + dashboard (:5173), real data
#   tradeit api       just the API
#   tradeit demo      dashboard on simulated data, no IBKR needed
#
# Without `tradeit login`, start IB Gateway yourself (paper, port 4002, API enabled).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$ROOT/.venv"
PY="$VENV/bin/python"
API_PORT="${DV02_API_PORT:-8000}"
WEB_PORT="${DV02_WEB_PORT:-5173}"

say() { printf '\033[1m%s\033[0m\n' "$*"; }
die() { printf 'tradeit: %s\n' "$*" >&2; exit 1; }

# Ask until something is entered. Hidden prompts show nothing while you paste,
# so an Enter pressed too early asks again instead of exiting (an early exit
# leaves the next paste going to the shell, and into its history).
ask() { # ask VAR "Prompt" [hidden]
  local __v="" __i
  for __i in 1 2 3; do
    if [ "${3:-}" = hidden ]; then
      read -r -s -p "$2 (hidden: nothing shows while you paste, then press Enter): " __v
      echo
    else
      read -r -p "$2: " __v
    fi
    [ -n "$__v" ] && break
    echo "  Nothing was entered; try again."
  done
  [ -n "$__v" ] || die "nothing entered"
  printf -v "$1" '%s' "$__v"
}

pick_python() {
  for c in python3.12 python3.11 python3.13 python3; do
    if command -v "$c" >/dev/null 2>&1; then
      v="$("$c" -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
      case "$v" in 3.11|3.12|3.13) echo "$c"; return 0 ;; esac
    fi
  done
  return 1
}

need_venv() {
  [ -x "$PY" ] || die "no Python environment yet; run: bin/tradeit setup"
}

GW_ENV="$ROOT/ibgw/.env"
GW_PORT="${IBKR_PORT_PAPER:-4002}"

port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
compose() { docker compose -f "$ROOT/ibgw/docker-compose.yml" "$@"; }
gateway_running() { [ -n "$(compose ps --status running -q 2>/dev/null)" ]; }

# Single-quote a value for a compose env file; fall back to double quotes
# (escaping \, " and $) when the value itself contains a single quote.
env_quote() {
  case "$1" in
    *"'"*) printf '"%s"' "$(printf '%s' "$1" | sed -e 's/[\\"]/\\&/g' -e 's/\$/$$/g')" ;;
    *) printf "'%s'" "$1" ;;
  esac
}

cmd_setup() {
  local py
  py="$(pick_python)" || die "needs Python 3.11 or 3.12 (brew install python@3.12)"
  if [ ! -x "$PY" ]; then
    say "Creating $VENV with $py ($("$py" --version))"
    "$py" -m venv "$VENV"
  fi
  say "Installing Python packages"
  "$PY" -m pip install --quiet --upgrade pip
  "$PY" -m pip install --quiet -r "$ROOT/services/api/requirements.txt"
  if [ ! -f "$ROOT/.env" ]; then
    cp "$ROOT/.env.example" "$ROOT/.env"
    say "Created .env from .env.example (IBKR ports, optional Flex token)"
  fi
  command -v npm >/dev/null 2>&1 || die "needs Node.js 20.19+ for the dashboard (brew install node)"
  say "Installing dashboard packages"
  (cd "$ROOT/apps/web" && npm install --no-fund --no-audit --loglevel=error)
  say "Done. Next: start IB Gateway (paper, 4002), then bin/tradeit doctor and bin/tradeit up"
}

cmd_login() {
  local user pass
  say "IB Gateway automatic login"
  echo "Use your PAPER trading username (Client Portal: Settings > Paper Trading Account),"
  echo "not your live one. It is saved only in ibgw/.env on this Mac: gitignored and"
  echo "readable only by your user. Never paste it into a chat."
  echo
  ask user "Paper username"
  ask pass "Password" hidden
  (
    umask 077
    {
      echo "TWS_USERID=$(env_quote "$user")"
      echo "TWS_PASSWORD=$(env_quote "$pass")"
      echo "TRADING_MODE=paper"
      echo "READ_ONLY_API=no"
      echo "TIME_ZONE=America/New_York"
      echo "AUTO_RESTART_TIME='11:45 PM'"
      echo "TWOFA_TIMEOUT_ACTION=restart"
      echo "RELOGIN_AFTER_TWOFA_TIMEOUT=yes"
      echo "EXISTING_SESSION_DETECTED_ACTION=primary"
    } > "$GW_ENV"
  )
  chmod 600 "$GW_ENV"
  unset pass
  say "Saved. Start it with: bin/tradeit gateway   (bin/tradeit up also starts it)"
}

cmd_gateway() {
  command -v docker >/dev/null 2>&1 || die "automatic login runs IB Gateway in Docker; install Docker Desktop or OrbStack"
  docker info >/dev/null 2>&1 || die "Docker isn't running; open Docker Desktop (or OrbStack) first"
  case "${1:-start}" in
    start)
      [ -f "$GW_ENV" ] || die "no login saved yet; run: bin/tradeit login"
      if ! gateway_running && port_open "$GW_PORT"; then
        die "something else is already on port $GW_PORT (the IB Gateway app?); quit it or use that one"
      fi
      compose up -d
      say "Logging in (about a minute)"
      for _ in $(seq 1 60); do
        if compose logs --tail 200 2>/dev/null | grep -q "Login has completed"; then
          say "IB Gateway is logged in on 127.0.0.1:$GW_PORT"
          return 0
        fi
        if compose logs --tail 200 2>/dev/null | grep -qi "login failed"; then
          compose logs --tail 30
          die "login failed; check the saved login with: bin/tradeit login"
        fi
        sleep 2
      done
      echo "Still logging in; follow along with: bin/tradeit gateway logs"
      ;;
    stop) compose down ;;
    status) compose ps ;;
    logs) compose logs -f --tail 100 ;;
    *) die "usage: tradeit gateway start|stop|status|logs" ;;
  esac
}

cmd_flex() {
  need_venv
  local qid token
  say "IBKR Flex: your daily NAV since the account opened"
  cat <<'TXT'
One time, in Client Portal, logged in with your PAPER username:
  1. Performance & Reports > Flex Queries > Activity Flex Query > "+".
     Name it DV02 NAV. Section: "Net Asset Value (NAV) in Base", select all fields.
     Format XML, period "Last 365 Calendar Days". Save and note its Query ID.
  2. On the same Flex Queries page: Flex Web Service Configuration (gear icon).
     Turn it on and generate a token.
Paste both below. They are saved only in .env on this Mac (gitignored, readable only by you).

TXT
  ask qid "Query ID"
  ask token "Token" hidden
  touch "$ROOT/.env"
  chmod 600 "$ROOT/.env"
  DV02_QID="$qid" DV02_TOKEN="$token" "$PY" - "$ROOT/.env" <<'PY'
import os, pathlib, sys
path = pathlib.Path(sys.argv[1])
pairs = {"IBKR_FLEX_QUERY_ID": os.environ["DV02_QID"].strip(), "IBKR_FLEX_TOKEN": os.environ["DV02_TOKEN"].strip()}
out, seen = [], set()
for line in path.read_text().splitlines():
    key = line.split("=", 1)[0].strip()
    if key in pairs:
        out.append(f"{key}={pairs[key]}")
        seen.add(key)
    else:
        out.append(line)
out += [f"{k}={v}" for k, v in pairs.items() if k not in seen]
path.write_text("\n".join(out) + "\n")
PY
  unset token
  say "Saved. Fetching your statement from IBKR (can take a minute)"
  (cd "$ROOT/services/api" && "$PY" -m dv02_api.flex paper) \
    || die "not loaded (reason above). Check the Query ID and token, then run bin/tradeit flex again"
  say "Done. A running dashboard picks it up on its next refresh; the API also re-fetches every 6 hours."
}

cmd_refresh() {
  need_venv
  cd "$ROOT/trading-engine"
  local cid port
  cid="$("$PY" -c 'from src.broker.ibkr import settings; print(settings.client_id_for("backfill", "paper"))')"
  port="$("$PY" -c 'from src.broker.ibkr import settings; print(settings.resolve_endpoint("paper").port)')"
  say "Filling any holes in the price history (the engine's backfill_gaps --auto)"
  "$PY" -m src.production.backfill_gaps --auto --profile paper --port "$port" --client-id "$cid" \
    || die "backfill failed (reason above); is IB Gateway running?"
  say "Refreshing daily bars and targets through the engine's daily runner (dry run: no orders are sent)"
  exec "$PY" -m src.production.daily_runner --profile paper --dry-run --client-id "$cid" "$@"
}

cmd_doctor() {
  need_venv
  cd "$ROOT/trading-engine" && exec "$PY" -m src.broker.ibkr.doctor "$@"
}

cmd_api() {
  need_venv
  cd "$ROOT/services/api" && exec "$PY" -m dv02_api --port "$API_PORT" "$@"
}

cmd_up() {
  need_venv
  [ -d "$ROOT/apps/web/node_modules" ] || die "dashboard packages missing; run: bin/tradeit setup"
  local api_pid web_pid
  if [ -f "$GW_ENV" ] && ! port_open "$GW_PORT"; then
    cmd_gateway start
  elif ! port_open "$GW_PORT"; then
    echo "Note: nothing on port $GW_PORT yet. Start IB Gateway, or save a login once with: bin/tradeit login"
  fi
  (cd "$ROOT/services/api" && exec "$PY" -m dv02_api --port "$API_PORT" "$@") &
  api_pid=$!
  trap 'kill $api_pid ${web_pid:-} 2>/dev/null; wait 2>/dev/null; exit 0' INT TERM
  for _ in $(seq 1 40); do
    curl -fsS "http://127.0.0.1:$API_PORT/api/v1/status" >/dev/null 2>&1 && break
    kill -0 "$api_pid" 2>/dev/null || die "the API exited during startup (see above)"
    sleep 0.5
  done
  (cd "$ROOT/apps/web" && API_URL="http://127.0.0.1:$API_PORT" exec npx vite --port "$WEB_PORT" --strictPort) &
  web_pid=$!
  sleep 2
  say "DV02 Fund: http://localhost:$WEB_PORT  (API http://127.0.0.1:$API_PORT/docs)  Ctrl-C stops both"
  command -v open >/dev/null 2>&1 && open "http://localhost:$WEB_PORT" || true
  wait
}

cmd_demo() {
  [ -d "$ROOT/apps/web/node_modules" ] || die "dashboard packages missing; run: bin/tradeit setup"
  cd "$ROOT/apps/web" && exec npx vite --mode demo --port "$WEB_PORT"
}

case "${1:-help}" in
  setup) shift; cmd_setup "$@" ;;
  login) shift; cmd_login "$@" ;;
  flex) shift; cmd_flex "$@" ;;
  refresh) shift; cmd_refresh "$@" ;;
  gateway) shift; cmd_gateway "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  up) shift; cmd_up "$@" ;;
  api) shift; cmd_api "$@" ;;
  demo) shift; cmd_demo "$@" ;;
  *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
